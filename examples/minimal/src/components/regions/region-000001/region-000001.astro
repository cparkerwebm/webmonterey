---
/*
 * The site footer, carrying the webmaster credit.
 *
 * Exists in this example so the built output can be asserted: the credit is an internal link to
 * /webmaster, and that page's outbound link to the agency opens in a new tab - both only
 * observable in dist/, not in a unit test.
 */
import Webmaster from '@cparkerwebm/webmonterey/webmonterey/webmaster/Webmaster.astro';
---

<footer class="webm-footer">
  <Webmaster />
</footer>

<style>
  @layer webm.components.core {
    .webm-footer {
      padding-block: var(--webm-space-lg);
      border-block-start: var(--webm-border-width-1) solid var(--webm-border-subtle);
    }
  }
</style>
